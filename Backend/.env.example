# Copy this file to ".env" and put your real keys in it.
# ".env" is git-ignored. This example file is safe to push.
GEMINI_API_KEY=your_gemini_api_key_here
MURF_API_KEY=your_murf_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Frontend URLs allowed to call this API (comma-separated, no trailing slash).
# Local: VS Code Live Server. After deploy, add your Vercel frontend URL.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
